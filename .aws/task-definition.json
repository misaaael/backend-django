{
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "533267264899.dkr.ecr.us-east-1.amazonaws.com/case-intelbras-backend:v2",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "DEBUG",
          "value": "False"
        },
        {
          "name": "SECRET_KEY",
          "value": "change-me-in-production"
        },
        {
          "name": "ALLOWED_HOSTS",
          "value": "*"
        },
        {
          "name": "INTELBRAS_BASE_URL",
          "value": "https://open-casainteligente.intelbras.com.br"
        },
        {
  	   "name": "TURNSTILE_ENABLED",
           "value": "true"
        },
        {
  	    "name": "TURNSTILE_SECRET_KEY",
  	    "value": "0x4AAAAAADsfw6JaGJyoYj_BQMbgxhHVMoU"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/case-intelbras-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "family": "case-intelbras-backend",
  "executionRoleArn": "arn:aws:iam::533267264899:role/case-intelbras-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
